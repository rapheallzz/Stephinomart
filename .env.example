# Stripe keys — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — from `stripe listen --print-secret` in dev,
# or your Stripe dashboard webhook endpoint in production
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Used to build absolute redirect URLs for Stripe Checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000
